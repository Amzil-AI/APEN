# APEN Agent MVP - Environment Variables
# Copy to .env and fill in your values

# ===== Required for Production =====
# Your Railway public URL (e.g., https://your-app.railway.app)
BASE_URL=

# OpenAI API key for Whisper transcription and AI features
OPENAI_API_KEY=

# ===== Google Calendar Integration =====
# Calendar ID (e.g., "primary" or "c_xxx@group.calendar.google.com")
GOOGLE_CALENDAR_ID=

# OAuth credentials (run scripts/oauth_refresh_token.py to get refresh token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Alternative: Service Account (instead of OAuth)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ===== Optional Features =====
# SMTP for email acknowledgments
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Vapi configuration (if using Vapi as voice provider)
VAPI_API_KEY=
