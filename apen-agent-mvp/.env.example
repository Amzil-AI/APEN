# APEN Agent MVP – environment variables
# Copy to .env and fill in values

# Server
PORT=8000
HOST=0.0.0.0

# Vapi (voice provider). In Vapi dashboard set Server URL to https://your-host/webhooks/vapi
# VAPI_API_KEY=your-vapi-secret-key
# Optional: if the call cuts immediately, we return a minimal assistant (no inline tools). For full routing/booking:
# - Create an assistant in Vapi with server-side tools (apen_route, apen_get_slots, apen_book_appointment) pointing to this Server URL, then set:
VAPI_ASSISTANT_ID=6e7ec3f7-9f71-432c-bb27-ff039d01c9b4
# - Or try inline tools (may cause "invalid assistant" on some Vapi versions):
# VAPI_INLINE_TOOLS=1

# Google Calendar (for appointment booking)
# Option A – Service account (requires a JSON key file):
# GOOGLE_APPLICATION_CREDENTIALS=./config/credentials/google-service-account.json
# GOOGLE_CALENDAR_ID=primary
# Option B – OAuth 2.0 (use when org policy blocks service account keys):
# 1. In Google Cloud: Credentials → Create credentials → OAuth client ID → Web application (not Desktop)
# 2. Add Authorized redirect URI: http://localhost:8765/
# 3. Set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET, then run: python scripts/oauth_refresh_token.py
# 3. Add the printed GOOGLE_REFRESH_TOKEN to .env
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx
# GOOGLE_REFRESH_TOKEN=xxx
GOOGLE_CALENDAR_ID=primary

# Audio testing: Whisper transcription (POST /audio/intent)
# OPENAI_API_KEY=sk-...

# Planning / app base URL (for download links in /planning/upload response)
# BASE_URL=https://your-app.example.com

# Email (acknowledgments + send): SMTP for auto-reply and planning email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=apen@example.com
